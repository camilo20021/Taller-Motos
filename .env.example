# Copia este archivo como ".env" y completa tus datos reales.
# NUNCA subas el archivo ".env" real a git (ya esta ignorado).

# Clave secreta de la aplicacion (usa una cadena larga y aleatoria en produccion)
SECRET_KEY=cambia-esta-clave-super-secreta

# La base de datos siempre es un archivo SQLite local (carpeta instance/ en
# desarrollo, o %LOCALAPPDATA%\TallerMotos en la version de escritorio).
# No requiere configuracion adicional.

# Configuracion de correo (Brevo) SOLO para precargarla en desarrollo (la
# app real la guarda cifrada en la base de datos, editable desde Ajustes ->
# Correo). La API key se saca gratis en brevo.com -> SMTP & API -> API Keys.
BREVO_API_KEY=
MAIL_REMITENTE_CORREO=tu_correo@ejemplo.com
MAIL_REMITENTE_NOMBRE=

# Datos del taller (unico taller que usa este sistema) y del administrador
# inicial. Solo se usan UNA vez, la primera vez que se arranca la app con la
# base de datos vacia, para crear ambos registros. Los mecanicos no usan
# contrasena (entran eligiendo su nombre); el administrador si.
TALLER_NOMBRE=Mi Taller
TALLER_NIT=
TALLER_DIRECCION=
TALLER_TELEFONO=

ADMIN_NOMBRE=Administrador
ADMIN_PASSWORD=cambiar123
